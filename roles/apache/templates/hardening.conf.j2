Applies the standard security settings used by the Apache role.
#}

# {{ ansible_managed }}

TraceEnable {{ apache_trace_enable }}

ServerSignature {{ apache_server_signature }}

ServerTokens {{ apache_server_tokens }}

FileETag {{ apache_file_etag }}

LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined

ErrorLogFormat "[%t] [%l] [pid %P] %F: %M"

{% if apache_manage_security_headers %}
<IfModule headers_module>

{% for header_name, header_value in apache_security_headers.items() %}
    Header always set {{ header_name }} "{{ header_value }}"
{% endfor %}

{% if apache_content_security_policy | length > 0 %}
    Header always set Content-Security-Policy "{{ apache_content_security_policy }}"
{% endif %}

{% if apache_enable_hsts %}
    Header always set Strict-Transport-Security "max-age={{ apache_hsts_max_age }}{% if apache_hsts_include_subdomains %}; includeSubDomains{% endif %}{% if apache_hsts_preload %}; preload{% endif %}" "expr=%{HTTPS} == 'on'"
{% endif %}

</IfModule>
{% endif %}